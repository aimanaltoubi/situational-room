# ══════════════════════════════════════════════════════════════
# .env — API Keys for the Situational Room
#
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your actual API keys below
#   3. NEVER commit .env to git (it's in .gitignore)
# ══════════════════════════════════════════════════════════════

# Anthropic — Claude API for report generation
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Cesium Ion — 3D globe rendering
# Get yours at: https://ion.cesium.com/tokens
CESIUM_TOKEN=

# RapidAPI — ADS-B Exchange + AeroDataBox (same key for both)
# Get yours at: https://rapidapi.com/
ADSBX_KEY=

# Datalastic — Marine/AIS vessel tracking
# Get yours at: https://datalastic.com/
DATALASTIC_KEY=
