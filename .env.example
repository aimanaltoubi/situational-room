# ══════════════════════════════════════════════════════════════
# .env — API Keys for the Situational Room
#
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your actual API keys below
#   3. NEVER commit .env to git (it's in .gitignore)
# ══════════════════════════════════════════════════════════════

# Google Gemini — report generation
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cesium Ion — 3D globe rendering
# Get yours at: https://ion.cesium.com/tokens
CESIUM_TOKEN=

# RapidAPI — ADS-B Exchange + AeroDataBox (same key for both)
# Get yours at: https://rapidapi.com/
ADSBX_KEY=

# Datalastic — Marine/AIS vessel tracking
# Get yours at: https://datalastic.com/
DATALASTIC_KEY=

# ── Public access control (optional) ─────────────────────────────
# Set BOTH to require an HTTP login before the site is served.
# Strongly recommended if you deploy this online — the dashboard
# triggers billed API calls, and it should not be left open.
SITE_USERNAME=
SITE_PASSWORD=
# ── Public shareable link (optional) ──────────────────────────
# Needed only for `python3 app.py --public`, which opens a temporary
# public URL via ngrok. Free token: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
